# ============================================================================
# Varsity Companion API — environment variables (example)
# ============================================================================
# Copy to `.env` and fill in real values. `.env` is git-ignored and excluded
# from the Docker image — NEVER commit real secrets.
#
# Every key below mirrors a field on `app.core.config.Settings`. Keys marked
# [REQUIRED] must be set or the app refuses to start.

# --- Database (Neon PostgreSQL) -------------------------------------------------
# [REQUIRED] Get this from your Neon project dashboard → Connection Details.
# IMPORTANT: use the `postgresql+psycopg://` scheme (psycopg v3 driver). The
# generic `postgresql://` scheme maps to the psycopg2 driver, which we do NOT
# ship and will crash at startup.
DATABASE_URL=postgresql+psycopg://username:password@host/dbname?sslmode=require

# --- JWT authentication --------------------------------------------------------
# [REQUIRED] Long, random string. Generate with: openssl rand -hex 32
# Never reuse across environments (dev/staging/production each get their own).
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- App environment -----------------------------------------------------------
# development | production | testing
#   development = docs on, non-secure cookies, verbose errors (local only)
#   production  = docs off, Secure cookies, generic errors, HSTS
#   staging     = identical hardening to production (for pre-prod smoke)
#   testing     = hardened but WITHOUT Secure cookies / HSTS (used by CI)
ENVIRONMENT=development

# --- CORS — which frontend origins may call this API ---------------------------
# Comma-separated. Local dev is usually the API's own origin; set the real
# frontend domain(s) for production.
CORS_ORIGINS=http://localhost:8000

# --- Transactional email (Resend, Week 2 Day 4) ---------------------------------
# Leave EMAIL_API_KEY empty to silently skip welcome emails (signup still works).
# Get a key from https://resend.com and verify EMAIL_FROM's domain there.
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=onboarding@varsitycompanion.co.za

# --- AI summary engine (Google Gemini, Month 2 Week 1) ---------------------------
# Get a key from Google AI Studio (https://aistudio.google.com). The app calls
# the Gemini REST API directly over httpx (no SDK). Leave empty to disable
# generation: /api/v1/ai/summarize returns 503 WITHOUT spending a daily credit.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Deep-link base URL for module sharing (client-constructed; documented only).
SHARE_LINK_BASE_URL=https://varsitycompanion.co.za

# --- POPIA hard-purge retention --------------------------------------------------
# Soft-deleted accounts older than this many days are eligible for physical
# erasure (purge endpoint). Default 30.
POPIA_RETENTION_DAYS=30

# --- Distributed rate limiting (optional, for scale) -----------------------------
# When set (e.g. "redis://host:6379/0"), slowapi shares rate-limit counters
# across workers/instances. Empty = in-memory (fine for a single instance,
# NOT correct across multiple workers). Requires the `limits[redis]` extra.
REDIS_URL=

# --- Logging ----------------------------------------------------------------------
# True (default) writes rotating log files in addition to stdout.
# Set false in containers/orchestrated deployments where stdout is captured.
LOG_TO_FILE=true
