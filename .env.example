# =============================================================================
# Varsity Companion — environment variables (example)
# =============================================================================
# Copy to `.env` and fill in real values. `.env` is git-ignored and excluded
# from the Docker image — NEVER commit real secrets.
#
#     cp .env.example .env
#
# Every key below mirrors a field on `app.core.config.Settings`.
# Only TWO are [REQUIRED]; everything else has a working default, so you can
# start with the two marked 🔴 and add the rest as you need them.
#
# Do not wrap values in quotes unless the value itself contains a comma.
# =============================================================================


# -----------------------------------------------------------------------------
# 🔴 REQUIRED — the app will not boot without these
# -----------------------------------------------------------------------------

# --- Database (PostgreSQL) ---------------------------------------------------
# Use the `postgresql+psycopg://` scheme — that is the psycopg v3 driver this
# project ships. A bare `postgresql://` is normalised for you, but being
# explicit avoids surprises.
#
# Local Docker (the port must match your `docker run -p`):
#   postgresql+psycopg://app_user:app_password@127.0.0.1:5544/varsity_companion_dev
#
# Neon (production) — keep `?sslmode=require`:
#   postgresql+psycopg://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- JWT signing secret ------------------------------------------------------
# Anyone who knows this can forge a login token for ANY account. Treat it like
# a password, and use a different value per environment.
#
# Generate one:
#     python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#
# ENFORCED AT BOOT when ENVIRONMENT is production or staging:
#   * must be at least 32 characters
#   * must not match a known weak default (e.g. "your-secret-key-here")
# A weak value in production makes the app REFUSE to start. That is deliberate:
# a guessable secret is worse than a failed deploy.
JWT_SECRET_KEY=


# -----------------------------------------------------------------------------
# 🟡 RECOMMENDED — features are degraded without these, but nothing crashes
# -----------------------------------------------------------------------------

# --- Google Gemini (AI summaries, recommendations, chat with your brief) -----
# Get a key: https://aistudio.google.com/apikey
#
# Leave empty and the AI endpoints return a clear 503 WITHOUT spending a daily
# credit. Everything else — auth, planner, materials search — keeps working.
GEMINI_API_KEY=

# Busy models fall back automatically to gemini-flash-lite-latest, then
# gemini-2.5-flash, so a transient provider outage does not fail the request.
GEMINI_MODEL=gemini-flash-latest

# --- Transactional email (Resend) --------------------------------------------
# Get a key: https://resend.com/api-keys  (and verify EMAIL_FROM's domain there)
#
# Leave empty to skip outgoing email: a warning is logged and signup still
# works. Nothing crashes.
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=onboarding@varsitycompanion.co.za


# -----------------------------------------------------------------------------
# ⚠️  CORS — A MISTAKE HERE LOOKS LIKE AN OUTAGE, NOT A CONFIG ERROR
# -----------------------------------------------------------------------------
# Comma-separated list of EXACT origins allowed to call this API.
# No trailing slashes. No wildcards. Scheme and port must match exactly.
#
# Local development (API + Vite dev server):
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
#
# Add your deployed frontend URL as well, e.g.:
#   CORS_ORIGINS=http://localhost:5173,https://your-app.example.com
#
# SYMPTOM OF A MISTAKE: the UI loads, but every action reports
# "Cannot reach the server", and the browser console shows a CORS error.
# The API's own logs show NO request arriving — the browser never sent it.


# -----------------------------------------------------------------------------
# Environment + security
# -----------------------------------------------------------------------------

# development | staging | production
#
#   development -> docs enabled, relaxed rate limits (30/min on login) so a
#                  live demo cannot lock itself out with typos
#   staging     -> production hardening, for pre-release smoke tests
#   production  -> docs disabled, Secure cookies, HSTS, STRICT rate limits
#                  (5/min on login) and the JWT strength check above
ENVIRONMENT=development

JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# POPIA: days a soft-deleted account is retained before it becomes eligible for
# hard purge (physical erasure).
POPIA_RETENTION_DAYS=30


# -----------------------------------------------------------------------------
# Shareable links
# -----------------------------------------------------------------------------
# Base URL used when the client builds a module deep-link.
# Local:      http://localhost:5173
# Production: https://varsitycompanion.co.za
SHARE_LINK_BASE_URL=http://localhost:5173


# -----------------------------------------------------------------------------
# Optional infrastructure — leave blank to disable
# -----------------------------------------------------------------------------

# --- Redis (shared rate-limit counters) --------------------------------------
#   BLANK -> counters live in this process's memory. Fine for ONE instance, but
#            they reset on restart and are NOT shared between workers.
#   SET   -> counters shared across instances. Required for multi-worker or
#            multi-instance deployments.
#   REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# --- Logging -----------------------------------------------------------------
# True writes rotating files under logs/ IN ADDITION to stdout.
# Set false in containers/orchestrated deployments where stdout is captured.
LOG_TO_FILE=true


# -----------------------------------------------------------------------------
# AI tuning — safe to leave at the defaults
# -----------------------------------------------------------------------------

# Upper bound on a generated summary, in tokens. 3072 produces a thorough
# multi-section study guide. (Was 512, which produced thin output.)
SUMMARY_MAX_OUTPUT_TOKENS=3072

# 0.0 = literal and repetitive, 1.0 = creative. 0.6 keeps guides useful without
# inventing content that is not in the student's notes.
SUMMARY_TEMPERATURE=0.6

# Advanced override. {model} is substituted with GEMINI_MODEL above.
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent


# -----------------------------------------------------------------------------
# RAG — "chat with your brief" retrieval
# -----------------------------------------------------------------------------
# Retrieval is KEYWORD-based today and needs NO configuration.
#
# Setting this true switches to embedding-based semantic retrieval, which needs
# a Gemini key with embedding access. The `embedding` column already exists and
# is nullable, so enabling it later requires NO schema change.
RAG_EMBEDDING_ENABLED=false
GEMINI_EMBEDDING_MODEL=text-embedding-004


# -----------------------------------------------------------------------------
# Tests — optional, the suite has safe built-in defaults
# -----------------------------------------------------------------------------
# `pytest` works with no .env at all. Set this only if your test database
# differs from the default. The suite REFUSES to run against any database whose
# name does not end in `_test`, so a typo here can never point tests at real
# data.
#
# TEST_DATABASE_URL=postgresql+psycopg://app_user:app_password@127.0.0.1:5544/varsity_companion_test
