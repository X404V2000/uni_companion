#!/bin/sh
#
# pre-push — refuses a force-push and refuses a remote branch delete.
#
# WHAT CHANGED AND WHY
# --------------------
# This hook used to refuse any push to `main`. On 2026-10-21 the founder
# reversed that rule: agents push straight to `main`, because Cloudflare deploys
# the web frontend from `main` and the branch-plus-PR cycle was costing more than
# it saved before a fixed deadline.
#
# Pushing to `main` is now allowed. What is STILL refused, because both destroy
# work that cannot be recovered from the branch itself:
#
#   1. a force-push (rewriting or discarding history)
#   2. deleting a remote branch
#
# The remote refs are provided on stdin as:
#   <local ref> SP <local sha> SP <remote ref> SP <remote sha> LF

# A zero SHA in the remote slot means the ref does not exist yet (a create).
ZERO="0000000000000000000000000000000000000000"

blocked=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$remote_ref" ] && continue

  # 1. Never force-push: an existing remote ref that is not an ancestor of what
  #    we are sending means history would be rewritten or discarded. On `main`
  #    that would destroy other agents' work with no way to recover it.
  if [ "$remote_sha" != "$ZERO" ] && [ "$local_sha" != "$ZERO" ]; then
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      echo "" >&2
      echo "  BLOCKED: this push would rewrite history on $remote_ref." >&2
      echo "  No force-pushing, including on main." >&2
      echo "  Pull, then re-apply your change on top." >&2
      blocked=1
    fi
  fi

  # 2. Never delete a branch on the remote.
  if [ "$local_sha" = "$ZERO" ]; then
    echo "" >&2
    echo "  BLOCKED: refusing to delete remote branch $remote_ref." >&2
    blocked=1
  fi
done

if [ "$blocked" -ne 0 ]; then
  cat >&2 <<'MSG'

  If you are certain this is correct (founder present, emergency), use:
      git push --no-verify ...
  and record why in agents/state/handoffs.json.

MSG
  exit 1
fi

exit 0
