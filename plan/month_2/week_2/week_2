#### 4. Developer Implementation Guide

##### Step 1: Create Static OpenAPI Exporter (`scripts/export_openapi.py`)

```python
"""
scripts/export_openapi.py

PURPOSE:
Generates static openapi.json from the FastAPI application instance.
Used by offshore developers for Flutter Dio/Drift client code generation.
"""

import json
import os
import sys

# Ensure app module is in python path
sys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), "..")))

from app.main import app

def export_schema():
    openapi_data = app.openapi()
    output_path = os.path.join(os.path.dirname(__file__), "..", "docs", "openapi.json")
    
    os.makedirs(os.path.dirname(output_path), exist_ok=True)
    
    with open(output_path, "w", encoding="utf-8") as f:
        json.dump(openapi_data, f, indent=2)
        
    print(f"[+] Successfully exported OpenAPI contract to: {output_path}")

if __name__ == "__main__":
    export_schema()

```

